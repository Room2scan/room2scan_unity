{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://room2scan.dev/schemas/unity-bridge-v1.schema.json",
  "title": "Unity Bridge Message v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messageId",
    "kind",
    "direction",
    "name",
    "sentAt",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "unity-bridge/v1"
    },
    "messageId": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "command",
        "event"
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "rn_to_unity",
        "unity_to_rn"
      ]
    },
    "name": {
      "type": "string",
      "enum": [
        "LoadRoom",
        "LoadFurnitureCatalog",
        "LoadLayout",
        "AddFurniture",
        "SelectFurniture",
        "RotateSelected",
        "DeleteSelected",
        "SaveLayout",
        "ResetEditor",
        "RoomLoaded",
        "FurnitureCatalogLoaded",
        "LayoutLoaded",
        "FurnitureAdded",
        "FurnitureSelected",
        "FurnitureChanged",
        "FurnitureDeleted",
        "PlacementChanged",
        "LayoutSaved",
        "EditorReset",
        "EditorError"
      ]
    },
    "sentAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "error": {
      "$ref": "#/$defs/bridgeError"
    }
  },
  "$defs": {
    "bridgeError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_json",
            "unsupported_schema",
            "unknown_command",
            "room_load_failed",
            "catalog_load_failed",
            "layout_load_failed",
            "asset_load_failed",
            "validation_failed",
            "save_failed",
            "internal_error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
